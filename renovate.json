{
  "baseBranches": [
    "main"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate: Update Anchore Enterprise Dependencies",
  "draftPR": true,
  "labels": [
    "anchore",
    "renovate",
    "kind::maintenance",
    "priority::1",
    "team::Empire"
  ],
  "enabledManagers": [
    "custom.regex",
    "helmv3"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker",
        "git-tags",
        "helm"
      ],
      "groupName": "Anchore",
      "postUpgradeTasks": {
        "commands": [
          "bump-chart-yaml",
          "bump-changelog '{{#each upgrades}}- {{depName}} {{currentVersion}} -> {{newVersion}}\\n{{/each}}'",
          "regenerate-helm-docs"
        ],
        "fileFilters": [
          "chart/Chart.yaml",
          "README.md",
          "CHANGELOG.md"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry1.dso.mil/bigbang/maintained/redis"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-bb\\.(?<build>\\d+)$"
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchFileNames": [
        "chart/deps/postgresql/**"
      ],
      "enabled": false
    }
  ],
  "separateMajorMinor": false,
  "postUpdateOptions": [
    "helmUpdateSubChartArchives"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update upstream anchore-enterprise chart version",
      "managerFilePatterns": [
        "/^chart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "name: anchore-enterprise\\nversion:\\s+(?<currentValue>.+)-bb\\.\\d+"
      ],
      "autoReplaceStringTemplate": "name: anchore-enterprise\nversion: {{{newValue}}}-bb.0",
      "depNameTemplate": "enterprise",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.anchore.io"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^chart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:[^\\S\\r\\n]+(?<currentValue>.+)",
        "- Enterprise:\\s+(?<currentValue>.+)"
      ],
      "depNameTemplate": "registry1.dso.mil/ironbank/anchore/enterprise/enterprise",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^chart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "image:[^\\S\\r\\n]+(?<depName>.+):(?<currentValue>.+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^chart/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?:image|kubectlImage|migrationPodImage):\\s+(?<depName>[^\\s:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/images\\.txt$/"
      ],
      "matchStrings": [
        "\\s*(?<depName>.+):(?<currentValue>.+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update postgresql image tag in values.yaml",
      "managerFilePatterns": [
        "/^chart/values\\.yaml$/",
        "/^chart/deps/postgresql/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository: ironbank/opensource/postgres/postgresql\\s+tag: \"?(?<currentValue>[^\"\\s]+)"
      ],
      "depNameTemplate": "registry1.dso.mil/ironbank/opensource/postgres/postgresql",
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://registry1.dso.mil"
    },
    {
      "customType": "regex",
      "description": "Update postgresql appVersion in deps/postgresql/Chart.yaml",
      "managerFilePatterns": [
        "/^chart/deps/postgresql/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s+\"(?<currentValue>.+)\""
      ],
      "depNameTemplate": "registry1.dso.mil/ironbank/opensource/postgres/postgresql",
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://registry1.dso.mil"
    }
  ]
}
